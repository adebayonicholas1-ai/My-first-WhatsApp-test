// ============================================================
//  ROUTE 2 — Twilio WhatsApp Webhook
//  (Twilio sends POST here when customer messages you)
// ============================================================
app.post('/webhook', async (req, res) => {
  console.log('\n📨 Incoming WhatsApp message received');
  console.log('Body:', req.body);

  // Twilio sends these fields
  const customerPhone = req.body.From || 'whatsapp:+2340000000000';
  const message       = req.body.Body || '';
  const customerName  = req.body.ProfileName || 'Customer';

  if (!message) {
    return res.status(200).send('<Response></Response>');
  }

  console.log(`👤 From: ${customerName} (${customerPhone})`);
  console.log(`💬 Message: ${message}`);

  try {
    // ── STEP 1: Analyse with Gemini ────────────────────────
    console.log('\n🤖 Analysing with Gemini AI...');
    const analysis = await analyseWithGemini(customerName, 'WhatsApp', message);
    console.log('📊 Analysis:', analysis);

    // ── STEP 2: Save enquiry ────────────────────────────────
    const enquiry = {
      id:           `ENQ${String(enquiries.length + 1).padStart(3, '0')}`,
      customerName,
      customerPhone,
      channel:      'WhatsApp',
      message,
      analysis,
      status:       'New',
      autoReplySent: false,
      createdAt:    new Date().toISOString()
    };
    enquiries.push(enquiry);
    console.log(`💾 Saved as enquiry ${enquiry.id}`);

    // ── STEP 3: Generate auto-reply ─────────────────────────
    console.log('\n✍️ Generating auto-reply...');
    const autoReply = await generateReply(
      customerName,
      message,
      analysis.category,
      analysis.response_tone
    );
    console.log('📝 Auto-reply ready');

    // ── STEP 4: Send auto-reply to customer ─────────────────
    await sendWhatsApp(customerPhone, autoReply);
    enquiry.autoReplySent = true;
    console.log('✅ Auto-reply sent to customer');

    // ── STEP 5: Alert staff if URGENT or HIGH ──────────────
    if (['URGENT', 'HIGH'].includes(analysis.priority)) {
      console.log('\n🚨 Priority is', analysis.priority, '— alerting staff...');
      const staffAlert = await generateStaffAlert(customerName, 'WhatsApp', analysis);
      await sendWhatsApp(TWILIO_TO, staffAlert);
      console.log('✅ Staff alert sent');
    } else {
      // Send normal notification to staff
      const normalAlert = await generateStaffAlert(customerName, 'WhatsApp', analysis);
      await sendWhatsApp(TWILIO_TO, normalAlert);
    }

    // ── STEP 6: Respond to Twilio (empty = no double reply) ─
    res.set('Content-Type', 'text/xml');
    res.send('<Response></Response>');

    console.log(`\n✅ Enquiry ${enquiry.id} processed successfully`);

  } catch (err) {
    console.error('\n❌ Webhook error:', err.message);
    res.status(500).send('<Response></Response>');
  }
});

// ============================================================
//  ROUTE 3 — Manual test endpoint
//  POST /test  { "name": "...", "message": "..." }
// ============================================================
app.post('/test', async (req, res) => {
  const {
    name    = 'Test Customer',
    phone   = 'whatsapp:+2348012345678',
    message = 'I want to know the price of your product',
    channel = 'WhatsApp'
  } = req.body;

  console.log('\n🧪 MANUAL TEST triggered');
  console.log(`👤 Name: ${name} | Channel: ${channel}`);
  console.log(`💬 Message: ${message}`);

  try {
    // Analyse
    console.log('\n🤖 Running Gemini analysis...');
    const analysis = await analyseWithGemini(name, channel, message);

    // Generate reply
    const autoReply = await generateReply(
      name, message, analysis.category, analysis.response_tone
    );

    // Generate staff alert
    const staffAlert = await generateStaffAlert(name, channel, analysis);

    // Save
    const enquiry = {
      id:        `ENQ${String(enquiries.length + 1).padStart(3, '0')}`,
      customerName: name,
      customerPhone: phone,
      channel,
      message,
      analysis,
      autoReply,
      staffAlert,
      status:    'New',
      createdAt: new Date().toISOString()
    };
    enquiries.push(enquiry);

    // Send WhatsApp messages
    const results = {};

    try {
      await sendWhatsApp(phone, autoReply);
      results.customerReply = 'sent';
    } catch (e) {
      results.customerReply = 'simulated (no Twilio)';
    }

    try {
      await sendWhatsApp(TWILIO_TO, staffAlert);
      results.staffAlert = 'sent';
    } catch (e) {
      results.staffAlert = 'simulated (no Twilio)';
    }

    res.json({
      success:   true,
      enquiry_id: enquiry.id,
      analysis,
      autoReply,
      staffAlert,
      whatsapp:  results,
      message:   '✅ Test completed successfully'
    });

    console.log('\n✅ Test completed:', enquiry.id);

  } catch (err) {
    console.error('❌ Test error:', err.message);
    res.status(500).json({ success: false, error: err.message });
  }
});

// ============================================================
//  ROUTE 4 — View all enquiries
// ============================================================
app.get('/enquiries', (req, res) => {
  res.json({
    total:     enquiries.length,
    urgent:    enquiries.filter(e => e.analysis?.priority === 'URGENT').length,
    new:       enquiries.filter(e => e.status === 'New').length,
    enquiries: enquiries.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt))
  });
});

// ============================================================
//  ROUTE 5 — Dashboard summary
// ============================================================
app.get('/dashboard', (req, res) => {
  const total    = enquiries.length;
  const urgent   = enquiries.filter(e => e.analysis?.priority === 'URGENT').length;
  const high     = enquiries.filter(e => e.analysis?.priority === 'HIGH').length;
  const resolved = enquiries.filter(e => e.status === 'Resolved').length;

  const categories = {};
  const channels   = {};
  const sentiments = {};

  enquiries.forEach(e => {
    if (e.analysis) {
      categories[e.analysis.category] = (categories[e.analysis.category] || 0) + 1;
      sentiments[e.analysis.sentiment] = (sentiments[e.analysis.sentiment] || 0) + 1;
    }
    channels[e.channel] = (channels[e.channel] || 0) + 1;
  });

  res.json({
    summary: {
      total_enquiries:   total,
      urgent_cases:      urgent,
      high_priority:     high,
      resolved:          resolved,
      pending:           total - resolved,
      auto_replies_sent: enquiries.filter(e => e.autoReplySent).length
    },
    breakdown: { categories, channels, sentiments },
    latest_5:  enquiries.slice(-5).reverse().map(e => ({
      id:       e.id,
      customer: e.customerName,
      channel:  e.channel,
      priority: e.analysis?.priority,
      category: e.analysis?.category,
      status:   e.status,
      time:     e.createdAt
    }))
  });
});

// ============================================================
//  ROUTE 6 — Update enquiry status
// ============================================================
app.patch('/enquiries/:id', (req, res) => {
  const { id }     = req.params;
  const { status } = req.body;
  const enquiry    = enquiries.find(e => e.id === id);

  if (!enquiry) {
    return res.status(404).json({ error: 'Enquiry not found' });
  }

  enquiry.status    = status;
  enquiry.updatedAt = new Date().toISOString();

  res.json({ success: true, enquiry });
});

