const express = require('express');
const axios   = require('axios');
require('dotenv').config();

const app  = express();
app.use(express.json());
app.use(express.urlencoded({ extended: true }));

// ── ENV VARIABLES (set these in Render dashboard) ───────────
const GEMINI_API_KEY   = process.env.GEMINI_API_KEY;
const TWILIO_SID       = process.env.TWILIO_ACCOUNT_SID;
const TWILIO_AUTH      = process.env.TWILIO_AUTH_TOKEN;
const TWILIO_FROM      = process.env.TWILIO_WHATSAPP_FROM;  // whatsapp:+14155238886
const TWILIO_TO        = process.env.TWILIO_WHATSAPP_TO;    // whatsapp:+234XXXXXXXXXX
const PORT             = process.env.PORT || 3000;

// ── IN-MEMORY STORE (acts as our database for MVP) ──────────
const enquiries = [];

// ============================================================
//  GEMINI AI — Analyse customer message
// ============================================================
async function analyseWithGemini(customerName, channel, message) {
  const prompt = `
You are EnquiryIQ AI for an African business customer support system.
Analyse this customer message and return ONLY a valid JSON object.
No explanation. No markdown. No code blocks. Just raw JSON.

Customer Name: ${customerName}
Channel: ${channel}
Message: ${message}

Return exactly this format:
{
  "category": "Order Complaint or Pricing Inquiry or Product Inquiry or Payment Issue or Complaint or General or Positive Feedback",
  "priority": "URGENT or HIGH or MEDIUM or LOW",
  "sentiment": "Very Angry or Frustrated or Neutral or Happy or Very Happy",
  "summary": "one sentence summary of what the customer wants",
  "suggested_action": "what staff should do next in one sentence",
  "response_tone": "Apologetic or Informative or Helpful or Celebratory"
}`;

  try {
    const res = await axios.post(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${GEMINI_API_KEY}`,
      {
        contents: [{ parts: [{ text: prompt }] }]
      },
      { headers: { 'Content-Type': 'application/json' } }
    );

    const raw = res.data.candidates[0].content.parts[0].text.trim();

    // Clean any accidental markdown code fences
    const cleaned = raw.replace(/```json|```/g, '').trim();
    return JSON.parse(cleaned);

  } catch (err) {
    console.error('Gemini analysis error:', err.message);
    return {
      category:         'General',
      priority:         'MEDIUM',
      sentiment:        'Neutral',
      summary:          'Customer sent an enquiry',
      suggested_action: 'Review and respond to customer',
      response_tone:    'Helpful'
    };
  }
}

// ============================================================
//  GEMINI AI — Generate auto-reply message
// ============================================================
async function generateReply(customerName, message, category, tone) {
  const prompt = `
You are a professional customer service AI for an African business called AfriShop.
Write a warm, empathetic auto-reply message for this customer.

Rules:
- Maximum 80 words
- Acknowledge their specific concern
- Tell them a human will respond within 1 hour
- Use warm, professional African business tone
- Sign off as "AfriShop Customer Care Team"
- Do NOT mention AI or automation
- Do NOT use asterisks or markdown

Customer name: ${customerName}
Their message: ${message}
Category: ${category}
Tone needed: ${tone}

Write ONLY the reply message. Nothing else.`;

  try {
    const res = await axios.post(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${GEMINI_API_KEY}`,
      {
        contents: [{ parts: [{ text: prompt }] }]
      },
      { headers: { 'Content-Type': 'application/json' } }
    );

    return res.data.candidates[0].content.parts[0].text.trim();

  } catch (err) {
    console.error('Gemini reply error:', err.message);
    return `Dear ${customerName}, thank you for contacting AfriShop. We have received your message and our team will respond within 1 hour. We appreciate your patience.\n\n— AfriShop Customer Care Team`;
  }
}

// ============================================================
//  GEMINI AI — Generate staff alert message
// ============================================================
async function generateStaffAlert(customerName, channel, analysis) {
  const priorityEmoji = {
    URGENT: '🔴',
    HIGH:   '🟡',
    MEDIUM: '🔵',
    LOW:    '🟢'
  };

  const emoji = priorityEmoji[analysis.priority] || '🔵';

  return `${emoji} *NEW ENQUIRY — EnquiryIQ*

*Customer:* ${customerName}
*Channel:* ${channel}
*Priority:* ${analysis.priority}
*Category:* ${analysis.category}
*Sentiment:* ${analysis.sentiment}

*Summary:* ${analysis.summary}

*Suggested Action:* ${analysis.suggested_action}

_Auto-reply has been sent to customer._
_Please follow up within 1 hour._

⏰ ${new Date().toLocaleString('en-NG', { timeZone: 'Africa/Lagos' })} (WAT)`;
}

// ============================================================
//  TWILIO — Send WhatsApp message
// ============================================================
async function sendWhatsApp(to, message) {
  if (!TWILIO_SID || !TWILIO_AUTH) {
    console.log('📱 [SIMULATED WhatsApp to', to, ']:\n', message);
    return { simulated: true };
  }

  try {
    const url = `https://api.twilio.com/2010-04-01/Accounts/${TWILIO_SID}/Messages.json`;

    const params = new URLSearchParams();
    params.append('From', TWILIO_FROM);
    params.append('To',   to);
    params.append('Body', message);

    const res = await axios.post(url, params, {
      auth: { username: TWILIO_SID, password: TWILIO_AUTH },
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
    });

    console.log('✅ WhatsApp sent to', to, '| SID:', res.data.sid);
    return res.data;

  } catch (err) {
    console.error('❌ Twilio error:', err.response?.data || err.message);
    throw err;
  }
}

